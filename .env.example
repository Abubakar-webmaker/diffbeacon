# ── AI providers ──────────────────────────────────────────────────────────────
# If GROQ_API_KEY is set it takes priority over Anthropic.
# Leave both empty to run deterministic diff only (no AI explanation).

# Groq — free tier / development
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic Claude — production
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Rate limiting ──────────────────────────────────────────────────────────────
# Max requests per IP per window. Defaults: 30 req / 60 s.
# Set RATE_LIMIT_DISABLED=true to disable (local dev only).
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_DISABLED=true

# ── Share store ────────────────────────────────────────────────────────────────
# How long shared reports are kept in memory (ms). Default: 24 h.
# Max number of stored shares before oldest is evicted. Default: 1000.
SHARE_TTL_MS=86400000
SHARE_MAX_ENTRIES=1000
