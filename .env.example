# --- Groq (free / testing) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile


# --- Claude (production / future) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
